{
  "description": "Glicko-2 vectors shared by the addon (DuelElo/Glicko.lua) and packages/core. Ratings in Glicko-1 scale, base 1200, tau 0.5, one rating period per duel. Compare numbers with an absolute tolerance of 1e-6. The first case is Glickman's published example (r 1464.06, RD 151.52, sigma 0.05999 on a 1500 base); the rest were produced by the Lua implementation after it matched that example.",
  "constants": {"r0": 1200, "rd0": 350, "sigma0": 0.06, "tau": 0.5, "scale": 173.7178, "clamp": 400, "rdMax": 350, "c": 25.8198889747, "pairWindowDays": 7, "pairWeights": [1, 0.5, 0.25, 0]},
  "cases": [
    {"name": "glickman paper example (1500 base shifted to 1200)", "fn": "rate", "player": {"r": 1200, "rd": 200, "sigma": 0.06}, "games": [{"r": 1100, "rd": 30, "score": 1}, {"r": 1250, "rd": 100, "score": 0}, {"r": 1400, "rd": 300, "score": 0}], "expected": {"r": 1164.05067054, "rd": 151.516524124, "sigma": 0.0599959842865}},
    {"name": "no games: RD grows by volatility only", "fn": "rate", "player": {"r": 1500, "rd": 80, "sigma": 0.06}, "games": [], "expected": {"r": 1500, "rd": 80.6761448418, "sigma": 0.06}},
    {"name": "new vs new, win", "fn": "update", "player": {"r": 1200, "rd": 350, "sigma": 0.06}, "opp": {"r": 1200, "rd": 350}, "score": 1, "weight": 1, "expected": {"r": 1362.31089391, "rd": 290.318963718, "sigma": 0.0599996753723}},
    {"name": "new vs new, loss", "fn": "update", "player": {"r": 1200, "rd": 350, "sigma": 0.06}, "opp": {"r": 1200, "rd": 350}, "score": 0, "weight": 1, "expected": {"r": 1037.68910609, "rd": 290.318963718, "sigma": 0.0599996753723}},
    {"name": "established equal, win", "fn": "update", "player": {"r": 1500, "rd": 60, "sigma": 0.06}, "opp": {"r": 1500, "rd": 60}, "score": 1, "weight": 1, "expected": {"r": 1510.18396824, "rd": 60.0154305713, "sigma": 0.05999990892}},
    {"name": "established equal, loss", "fn": "update", "player": {"r": 1500, "rd": 60, "sigma": 0.06}, "opp": {"r": 1500, "rd": 60}, "score": 0, "weight": 1, "expected": {"r": 1489.81603176, "rd": 60.0154305713, "sigma": 0.05999990892}},
    {"name": "upset win vs +300", "fn": "update", "player": {"r": 1400, "rd": 80, "sigma": 0.06}, "opp": {"r": 1700, "rd": 80}, "score": 1, "weight": 1, "expected": {"r": 1429.77777342, "rd": 79.610939352, "sigma": 0.0600068872704}},
    {"name": "expected win vs -300", "fn": "update", "player": {"r": 1700, "rd": 80, "sigma": 0.06}, "opp": {"r": 1400, "rd": 80}, "score": 1, "weight": 1, "expected": {"r": 1705.58412029, "rd": 79.6107618631, "sigma": 0.0599986577155}},
    {"name": "clamp: opponent +900 counts as +400 (win)", "fn": "update", "player": {"r": 1200, "rd": 100, "sigma": 0.06}, "opp": {"r": 2100, "rd": 100}, "score": 1, "weight": 1, "expected": {"r": 1248.57194158, "rd": 99.1900216296, "sigma": 0.0600083323966}},
    {"name": "clamp: same as +400 exactly (win)", "fn": "update", "player": {"r": 1200, "rd": 100, "sigma": 0.06}, "opp": {"r": 1600, "rd": 100}, "score": 1, "weight": 1, "expected": {"r": 1248.57194158, "rd": 99.1900216296, "sigma": 0.0600083323966}},
    {"name": "clamp: opponent -1000 counts as -400 (loss)", "fn": "update", "player": {"r": 1800, "rd": 100, "sigma": 0.06}, "opp": {"r": 800, "rd": 100}, "score": 0, "weight": 1, "expected": {"r": 1751.42805842, "rd": 99.1900216296, "sigma": 0.0600083323966}},
    {"name": "pair weight 0.5", "fn": "update", "player": {"r": 1500, "rd": 90, "sigma": 0.06}, "opp": {"r": 1550, "rd": 90}, "score": 1, "weight": 0.5, "expected": {"r": 1512.17006594, "rd": 88.9651001736, "sigma": 0.0600003492342}},
    {"name": "pair weight 0.25", "fn": "update", "player": {"r": 1500, "rd": 90, "sigma": 0.06}, "opp": {"r": 1550, "rd": 90}, "score": 1, "weight": 0.25, "expected": {"r": 1506.08503297, "rd": 89.4825500868, "sigma": 0.0600001746171}},
